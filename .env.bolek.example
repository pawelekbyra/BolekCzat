# Agent Bolek local/deployment overlay for LibreChat.
# Usage: copy .env.example to .env, then copy these values into .env and replace
# BOLEK_OPENAI_ADAPTER_KEY only after the kulfon adapter is deployed.

APP_TITLE=Agent Bolek
CONFIG_PATH=./librechat.bolek.yaml

BOLEK_API_BASE_URL=https://kulfon.pawel-perfect.workers.dev/v1
BOLEK_OPENAI_ADAPTER_KEY=replace-me
BOLEK_MODEL=bolek

# Optional: while BolekCzat is only the Agent Bolek UI, keep built-in providers
# out of the initial selector. Do not remove support from the codebase.
# ENDPOINTS=
